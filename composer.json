{
    "name": "ugarit/envoy",
    "description": "Elegant SSH tasks for PHP.",
    "keywords": [
        "ssh",
        "ugarit"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^7.2|^8.0",
        "guzzlehttp/guzzle": "^6.0|^7.0|^8.0",
        "heritage/support": "^1.00.00",
        "symfony/console": "^4.3|^5.0|^6.0|^7.0|^8.0",
        "symfony/process": "^4.3|^5.0|^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^8.0|^9.0|^10.4"
    },
    "suggest": {
        "ext-posix": "Required to determine the System user on Unix systems."
    },
    "bin": [
        "bin/envoy"
    ],
    "autoload": {
        "psr-4": {
            "Ugarit\\Envoy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ugarit\\Envoy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
